# Local setup: uv run --frozen python scripts/setup_local.py
# It generates every key below and never overwrites an existing .env.
# For manual setup, generate ALL four keys, including valid Fernet, before check.
# Enter actual production values only in Render or GitHub maintenance secrets.
# Never commit real secrets; keep all keys stable across deployments.
# Generate SECRET_KEY, AUDIT_HMAC_KEY and MFA_KEY independently, once per key:
# uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate FIELD_ENCRYPTION_KEY (Fernet):
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-with-generated-secret
AUDIT_HMAC_KEY=replace-with-generated-independent-secret
MFA_KEY=replace-with-generated-independent-secret
FIELD_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Local defaults. Render: DEBUG=False; CAPTCHA_ENFORCED=True; API_DOCS_ENABLED=False.
DEBUG=True
# Local SQLite: memory cache. Production defaults to shared DB cache when DEBUG=False.
# Set True for PostgreSQL / multiple workers; apply migrate before serving traffic.
CACHE_SHARED=False
# scripts/serve_backend.py enables this automatically for both HTTP and worker.
# Local runserver: start procesar_sincronizaciones in another terminal.
SYNC_WORKER_REQUIRED=False
CAPTCHA_ENFORCED=False
API_DOCS_ENABLED=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=sqlite:///db.sqlite3
# Render: internal DATABASE_URL from datapulse-db in Virginia.
# Local PostgreSQL: postgresql://datapulse:YOUR_PASSWORD@localhost:5432/datapulse
POSTGRES_PASSWORD=replace-local-demo-password
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Render: https://YOUR-PROJECT.pages.dev, exact origin without trailing slash.
# Render terminates TLS and sets X-Forwarded-Proto: enable both below there.
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL_HEADER=False
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
# Optional independent JWT key; blank uses SECRET_KEY.
JWT_SIGNING_KEY=
WORLD_BANK_URL=https://api.worldbank.org/v2
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD
REST_COUNTRIES_URL=https://api.restcountries.com/countries/v5
REST_COUNTRIES_API_KEY=
EXTERNAL_API_TIMEOUT=10
# Optional backup encryption recipient; never commit private key material.
BACKUP_GPG_KEY=

# Render Docker command: sh scripts/render-start.sh (PORT=8000).
# Cloudflare Pages public build variables:
# NODE_VERSION=22.12.0
# SKIP_DEPENDENCY_INSTALL=true
# API_URL=https://YOUR-BACKEND.onrender.com/api/
